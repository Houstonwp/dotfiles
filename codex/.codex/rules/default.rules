prefix_rule(pattern=["uv", "run"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "UV_CACHE_DIR=.uv-cache uv sync"], decision="allow")
prefix_rule(pattern=["gh", "pr", "checks"], decision="allow")
prefix_rule(pattern=["gh", "run", "view"], decision="allow")
prefix_rule(pattern=["cargo", "test"], decision="allow")
prefix_rule(pattern=["cargo", "fmt"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "RUSTDOCFLAGS=\"-D warnings\" cargo doc --workspace --no-deps"], decision="allow")
prefix_rule(pattern=["cargo", "clippy"], decision="allow")
prefix_rule(pattern=["xcodebuild"], decision="allow")
